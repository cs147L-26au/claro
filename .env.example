# Server only. Used by task priorities, decision research/plans, and universal priorities.
# Priority suggestions prefer OpenAI, falling back to Groq only when no OpenAI key is set.
# Decision research/plans require OpenAI: one web-search call, then one formatting call.
# A Supabase project key cannot replace a model key. Restart npm run api after changing it.
# Never prefix either provider key with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server-only model for Responses API web search; OPENAI_MODEL formats the final plan.
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# Optional alternative provider for priority suggestions: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
API_PORT=8787
# Default binds only to this computer. For phone testing on trusted Wi-Fi,
# set API_HOST=0.0.0.0 and point EXPO_PUBLIC_API_URL at your computer's LAN IP.
API_HOST=127.0.0.1
# Public URL of the local Node AI server, not the Supabase project URL.
# No secret belongs here. Restart Expo after changing this address.
EXPO_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://127.0.0.1:8081

# Supabase Auth and stored tasks/priorities: public project URL and client key only.
# These credentials do not run AI analysis; the model-provider keys above are separate.
# Never use a service-role or secret key in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_SUPABASE_URL=https://hexdjlxqcrodaugntwlw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin tooling only. Not required by the local AI proxy and never exposed to Expo.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://hexdjlxqcrodaugntwlw.supabase.co/auth/v1/.well-known/jwks.json
