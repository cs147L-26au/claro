# Server only. Create a free key at https://console.groq.com/keys
# Never prefix this key with EXPO_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
API_PORT=8787
# Default binds only to this computer. For phone testing on trusted Wi-Fi,
# set API_HOST=0.0.0.0 and point EXPO_PUBLIC_API_URL at your computer's LAN IP.
API_HOST=127.0.0.1
# Public URL only; no secret belongs here.
EXPO_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://127.0.0.1:8081
