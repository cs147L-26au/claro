{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "node": "22.23.3"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.3"
    },
    "beta": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "node": "22.23.3"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-testflight": {
      "extends": "development",
      "developmentClient": true,
      "distribution": "store",
      "autoIncrement": true
    }
  }
}
